# Local development only. Copy to .env in the project root.
DJANGO_SECRET_KEY=local-development-only-replace-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=worldline
POSTGRES_USER=worldline
POSTGRES_PASSWORD=worldline-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Optional M3. Leave disabled until you configure services and review their costs.
AI_ENABLED=false
BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=
# An account-available model supporting Responses structured outputs; no default.
OPENAI_MODEL=
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=50
AI_MAX_OUTPUT_TOKENS=1200
# Set 1–3600 only if your Brave plan explicitly grants storage rights.
AI_WEB_CACHE_SECONDS=0
