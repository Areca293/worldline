# Local development only. Copy to .env in the project root.
DJANGO_SECRET_KEY=local-development-only-replace-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=worldline
POSTGRES_USER=worldline
POSTGRES_PASSWORD=worldline-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Optional M3. Leave disabled until you configure services and review their costs.
AI_ENABLED=false
AI_MODEL_PROVIDER=openai
BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=
# An account-available model supporting Responses structured outputs; no default.
OPENAI_MODEL=
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=50
AI_MAX_OUTPUT_TOKENS=1200
# Set 1–3600 only if your Brave plan explicitly grants storage rights.
AI_WEB_CACHE_SECONDS=0

# Optional local model. Set AI_MODEL_PROVIDER=lmstudio; no OpenAI key is needed.
# Confirm the port and identifier using lms server status and GET /v1/models.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=
LM_STUDIO_TIMEOUT_SECONDS=60
# Bump when changing local weights, thinking mode or other saved inference settings.
LM_STUDIO_CONFIG_REVISION=1

# Optional HTTPS relay; separate from official OpenAI and local LM Studio.
# Set AI_MODEL_PROVIDER=relay only after configuring the key and approving paid use.
# Base URL MUST include /v1. Allowed hosts: code.anyxml.com and cncode.anyxml.com.
RELAY_BASE_URL=https://code.anyxml.com/v1
RELAY_API_KEY=
RELAY_MODEL=claude-sonnet-5
RELAY_TIMEOUT_SECONDS=60
# Bump when changing the key's group/routing in the console without rotating its key.
RELAY_CONFIG_REVISION=1
# Initial relay recommendation: user 10/day, global 20/day, output 1200 tokens.
# Review the existing AI_* limits above; these are request limits, not dollar budgets.
